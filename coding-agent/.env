# ============================================================
# Coding Agent Configuration
# ============================================================

# --- LLM Provider (OpenRouter) ---
# Get your API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
LLM_PROVIDER=openrouter
LLM_MODEL=meta-llama/llama-3.1-70b-instruct

# --- Optional: Other Providers ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=

# --- Local Embeddings (Ollama) ---
# Install Ollama: https://ollama.ai
# Pull embedding model: ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_MODEL=qwen2.5-coder:7b

# --- Database ---
# PostgreSQL with pgvector (primary)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/coding_agent
# SQLite fallback (used if PostgreSQL unavailable)
SQLITE_DB_PATH=./data/coding-agent.db

# --- Agent Settings ---
AGENT_MAX_ITERATIONS=50
AGENT_TOKEN_BUDGET=128000
AGENT_TEMPERATURE=0.1

# --- Logging ---
LOG_LEVEL=debug
LOG_PRETTY=true

# --- Sandbox ---
SANDBOX_WORKSPACE=/tmp/coding-agent-workspace
SANDBOX_TIMEOUT_MS=30000

# --- Vector Dimensions (must match embedding model) ---
# nomic-embed-text = 768 dimensions
PGVECTOR_DIMENSIONS=768
DB_POOL_SIZE=10