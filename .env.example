# App
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
LOG_LEVEL=INFO

# Database (PostgreSQL for prod, SQLite for dev)
DATABASE_URL=postgresql+asyncpg://agent:password@db:5432/coding_agent
# DEV fallback: sqlite+aiosqlite:///./dev.db

# Redis
REDIS_URL=redis://redis:6379/0

# Auth
# Generate real values for anything exposed beyond localhost, e.g.
#   python -c "import secrets; print('sk-' + secrets.token_urlsafe(32))"
# Startup REFUSES APP_ENV=production while these hold their dev defaults.
API_KEYS=sk-dev-key-1,sk-dev-key-2
JWT_SECRET=change-me-in-production-min-32-chars
JWT_ALGORITHM=HS256

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# LLM Providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEFAULT_PROVIDER=openrouter
DEFAULT_MODEL=stealth/ox-alpha

# Sandbox (Docker)
DOCKER_HOST=unix:///var/run/docker.sock
SANDBOX_TIMEOUT=300
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1.0
SANDBOX_IMAGE=python:3.11-slim

# File Upload
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=.py,.js,.ts,.json,.yaml,.yml,.md,.txt,.csv,.html,.css